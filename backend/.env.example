# ─────────────────────────────────────────────────────────────────────
# Backend Environment Variables — Local Development
# ─────────────────────────────────────────────────────────────────────
# Copy this file to ".env" and fill in your values.
#   cp backend/.env.example backend/.env
#
# start-backend.sh loads this file automatically — no need to
# manually export variables before running.
# ─────────────────────────────────────────────────────────────────────

# ── MySQL connection ──────────────────────────────────────────────────
# Defaults shown below — only change what differs on your machine.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=insurance_portal
DB_USER=root
DB_PASSWORD=

# ── JWT signing key ───────────────────────────────────────────────────
# Required in production (min 32 chars). Left empty locally, start-backend.sh
# generates a random ephemeral key for the session.
#   openssl rand -hex 32
JWT_SECRET=

# ── AI features (Auto Check + Insurance AI Assistant) ────────────────
# Get your key at https://console.x.ai
XAI_API_KEY=

# ── Admin account ─────────────────────────────────────────────────────
# The initial admin is created only when ADMIN_PASSWORD is set — there is no
# default password. Choose your own strong value.
ADMIN_EMAIL=admin@dicp.com.mm
ADMIN_PASSWORD=

# ── Allowed browser origins (CORS) ────────────────────────────────────
# Comma-separated; wildcards are rejected at startup.
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5173

# ── Demo data / API docs (local only) ─────────────────────────────────
# DEMO_DATA_ENABLED=true seeds demo agents/customers with well-known passwords.
# SWAGGER_ENABLED=true exposes /swagger-ui.html and /v3/api-docs.
DEMO_DATA_ENABLED=false
SWAGGER_ENABLED=false

# ── Google sign-in (optional) ─────────────────────────────────────────
# When set, Google access tokens must be issued for this client ID.
GOOGLE_CLIENT_ID=

# ── File storage ──────────────────────────────────────────────────────
# Where uploaded documents are stored. Default: backend/uploads/
# FILE_STORAGE_DIR=./uploads
